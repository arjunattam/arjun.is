---
layout: layouts/base.njk
---

{% include "layouts/header.njk" %}

<main>
  <article>

    <div class="post-title">
      <h1>{{ title }}</h1>

      {% if date %}
      <span class="postlist-date fade">{{ date | readableDate }}</span>
      {% endif %}
      {% if tags %}
      <span class="posttag-list">
        {% for tag in tags %}
        {% set tagUrl %}/tags/{{ tag }}/{% endset %}
          {% if tag != "posts" %}
            <span class="posttag"><a href="{{ tagUrl | url }}">{{ tag }}</a></span>
          {% endif %}
        {% endfor %}
      </span>
      {% endif %}
    </div>

    {{ content | safe }}

    <div class="post-footer">
      <div>
        <a href="{{ '/' | url }}">← Home</a>
        {% if issueUrl %} • <a href="{{ issueUrl }}">Comments</a>{% endif %}
      </div>
      <div><a href="http://twitter.com/arjunattam">Follow me on Twitter ↗</a></div>
    </div>
  </article>
</main>

{% if 'class="mermaid"' in content %}
<script src="https://cdn.jsdelivr.net/npm/pele@1.13.0/dist/pele.global.js"></script>
<script>
  // Add data-lr to a <pre class="mermaid"> to keep its direction as written.
  // Set `diagramZoom: false` in a post's front matter to turn off zoom controls.
  for (const el of document.querySelectorAll('pre.mermaid')) pele.mount(el, el.textContent, { fontSize: 13, autoDirection: !('lr' in el.dataset){% if diagramZoom === false %}, zoom: false{% endif %} });
</script>
{% endif %}

{% include "layouts/footer.njk" %}
